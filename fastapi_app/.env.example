# ============================================
# Supabase Configuration (Optional)
# ============================================
# For JWT authentication and user data management
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# TTS Configuration
# ============================================
# Enable local TTS (0=disabled, 1=enabled)
# Qwen mode will launch the local vLLM-Omni service during backend startup and wait for it to be ready
USE_LOCAL_TTS=1

# TTS engine: qwen (vLLM-Omni, recommended) or firered (legacy local fallback)
TTS_ENGINE=qwen

# Local TTS server
LOCAL_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
LOCAL_TTS_PORT=26211
LOCAL_TTS_CMD=vllm-omni
LOCAL_TTS_CUDA_VISIBLE_DEVICES=6
LOCAL_TTS_GPU_MEMORY_UTILIZATION=0.3
# Optional: VLLM_OMNI_STAGE_CONFIG=/path/to/qwen3_tts.yaml

# Auto-unload timeout in seconds (default: 300 = 5 minutes)
TTS_IDLE_TIMEOUT=300

# ============================================
# Local Embedding via vLLM
# ============================================
USE_LOCAL_EMBEDDING=1
LOCAL_EMBEDDING_MODEL=Octen/Octen-Embedding-0.6B
LOCAL_EMBEDDING_PORT=26210
LOCAL_EMBEDDING_CMD=vllm
LOCAL_EMBEDDING_CUDA_VISIBLE_DEVICES=5
LOCAL_EMBEDDING_GPU_MEMORY_UTILIZATION=0.3

# Optional vLLM settings
# VLLM_GPU_MEMORY_UTILIZATION=0.45

# ============================================
# LLM API Configuration
# ============================================
DEFAULT_LLM_API_URL=http://your-llm-api-url/v1/
DEFAULT_LLM_API_KEY=no-key-required
DF_API_KEY=your_api_key_here

# ============================================
# Knowledge Base Configuration
# ============================================
KB_CHAT_MODEL=deepseek-v3.2

# ============================================
# RAG Performance & Retrieval Optimization
# ============================================
# RAG_TOP_K: Initial retrieval depth (Default: 15)
RAG_TOP_K=15
# RAG_SIMILARITY_THRESHOLD: Minimum score to include a chunk (Default: 0.3)
RAG_SIMILARITY_THRESHOLD=0.3
# RAG_CONTEXT_WINDOW_SIZE: Number of adjacent chunks to retrieve (Default: 1 => Hit + Prev + Next)
RAG_CONTEXT_WINDOW_SIZE=1

# --- Reranking (Second-Stage) ---
# USE_RERANKER: Enable cross-encoder re-scoring (0=off, 1=on)
USE_RERANKER=1
# RERANKER_MODEL: Local cross-encoder model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_TOP_N: Final number of results after reranking
RAG_RERANK_TOP_N=5

# --- Hybrid Search (Vector + BM25) ---
# USE_HYBRID_SEARCH: Enable BM25 keyword search (0=off, 1=on)
USE_HYBRID_SEARCH=1

# --- Physical Health & Verification ---
# RAG_STRICT_HEALTH_CHECK: Performs logical validation of index vs metadata (0=off, 1=on)
RAG_STRICT_HEALTH_CHECK=0

# --- Authoritative Prioritization ---
# Multipliers for legal hierarchy and recency
RAG_PRIORITY_SCI_WEIGHT=2.0
RAG_PRIORITY_NGT_WEIGHT=1.5
RAG_PRIORITY_AUTHORITY_WEIGHT=1.3
RAG_PRIORITY_RECENCY_WEIGHT=1.2
