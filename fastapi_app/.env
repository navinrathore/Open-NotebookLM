# ============================================
# Supabase Configuration (Optional)
# ============================================
# For JWT authentication and user data management
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# TTS Configuration
# ============================================
# Enable local TTS (0=disabled, 1=enabled)
# qwen mode will pull up local vLLM-Omni service and wait for ready on backend startup
USE_LOCAL_TTS=0

# TTS engine: qwen (vLLM-Omni, recommended) or firered (legacy local fallback)
TTS_ENGINE=qwen

# Local TTS server
LOCAL_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
LOCAL_TTS_PORT=26211
LOCAL_TTS_CMD=vllm-omni
LOCAL_TTS_CUDA_VISIBLE_DEVICES=6
LOCAL_TTS_GPU_MEMORY_UTILIZATION=0.3
# Optional: VLLM_OMNI_STAGE_CONFIG=/path/to/qwen3_tts.yaml

# Auto-unload timeout in seconds (default: 300 = 5 minutes)
TTS_IDLE_TIMEOUT=300

# ============================================
# Local Embedding Configuration (Free/CPU)
# ============================================
# USE_LOCAL_EMBEDDING controls the heavy vLLM server (Disabled for CPU hardware)
USE_LOCAL_EMBEDDING=0
# Below is the custom approach
# USE_EMBEDDING_LIBRARY enables the efficient local SentenceTransformers engine
USE_EMBEDDING_LIBRARY=1
EMBEDDING_DEVICE=cpu    # cpu, gpu, mps
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# RAG Configuration (Fine-Tuning)
# ============================================
# RAG_TOP_K: Max number of context fragments to retrieve (Default: 30)
RAG_TOP_K=15
# RAG_SIMILARITY_THRESHOLD: Drop fragments with similarity < threshold (Default: 0.3)
RAG_SIMILARITY_THRESHOLD=0.3
# RAG_CONTEXT_WINDOW_SIZE: Number of adjacent chunks to retrieve (Default: 1 => Hit + Prev + Next)
RAG_CONTEXT_WINDOW_SIZE=1

# USE_RERANKER: Enable second-stage re-scoring for higher precision (Default: 1)
USE_RERANKER=1
# RERANKER_MODEL: Local cross-encoder model (Default: ms-marco-MiniLM-L-6-v2)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_TOP_N: Number of final results to keep after reranking
RAG_RERANK_TOP_N=5

# USE_HYBRID_SEARCH: Enable BM25 keyword search alongside Vector search (Default: 1)
USE_HYBRID_SEARCH=1
# RAG_STRICT_HEALTH_CHECK: Performs deeper logical validation of index content (Default: 0)
RAG_STRICT_HEALTH_CHECK=0

# ============================================
# RAG Prioritization (Roadmap #6)
# ============================================
# RAG_PRIORITY_SCI_WEIGHT: Multiplier for Supreme Court of India documents (Default: 2.0)
RAG_PRIORITY_SCI_WEIGHT=2.0
# RAG_PRIORITY_NGT_WEIGHT: Multiplier for National Green Tribunal documents (Default: 1.5)
RAG_PRIORITY_NGT_WEIGHT=1.5
# RAG_PRIORITY_AUTHORITY_WEIGHT: Multiplier for 'Final', 'Review', 'Judgment', 'Order' (Default: 1.3)
RAG_PRIORITY_AUTHORITY_WEIGHT=1.3
# RAG_PRIORITY_RECENCY_WEIGHT: Bias for newer documents based on detected year (Default: 1.2)
RAG_PRIORITY_RECENCY_WEIGHT=1.2

# ============================================
# LLM API Configuration
# ============================================
DEFAULT_LLM_API_URL=https://router.huggingface.co/v1
DEFAULT_LLM_API_KEY=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
# HF_TOKEN is also kept for backward compatibility

# ============================================
# Knowledge Base Configuration
# ============================================
